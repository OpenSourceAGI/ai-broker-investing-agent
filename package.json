{
  "name": "ai-broker-investing-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Trading bots with news research analysts, algorithmic entry/exit signals, copy experts, and prediction markets",
  "license": "rights.institute/prosper",
  "author": "vtempest",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "cf-typegen": "turbo run cf-typegen",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:migrate:local": "turbo run db:migrate:local",
    "db:migrate:remote": "turbo run db:migrate:remote",
    "docs:generate": "turbo run docs:generate",
    "docs:generate:api": "turbo run docs:generate:api",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
