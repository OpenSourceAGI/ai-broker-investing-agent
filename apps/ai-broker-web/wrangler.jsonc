/**
 * Cloudflare Workers configuration for the Next.js app, built with
 * `vinext build` (via @cloudflare/vite-plugin) and deployed with
 * `vinext-cloudflare deploy`.
 *
 * Secrets (set with `wrangler secret put <NAME>`):
 *   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
 *   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, CRON_SECRET, RESEND_API_KEY (optional fallback)
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ai-broker-investing-agent",
  // Wraps vinext's fetch handler to add cron trigger routing.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Backs the vinext CDN cache adapter (page-level ISR) in vite.config.ts.
  "cache": {
    "enabled": true
  },
  "assets": {
    // Client bundle emitted by `vinext build`.
    "directory": "dist/client",
    "binding": "ASSETS",
    // vinext routes unmatched paths through the Worker, not the asset server.
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-broker-db",
      "database_id": "37dbe79c-2687-4127-ad02-2372e15ac077",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Workers: outbound email for auth (verification, password
  // reset) and team invitations. Requires Email Routing to be enabled on the
  // zone and the sender address configured under a verified domain.
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  // Replaces the Vercel crons: each schedule is routed to its API route by the
  // scheduled handler in worker/index.ts.
  "triggers": {
    "crons": ["0 0 * * *", "15 0 * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://autoinvestment.broker",
    "EMAIL_FROM": "noreply@autoinvestment.broker"
  },
  "observability": {
    "enabled": true
  }
}
