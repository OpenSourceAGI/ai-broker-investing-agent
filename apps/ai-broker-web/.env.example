#### App Main
NEXT_PUBLIC_APP_URL=https://autoinvestment.broker
NEXT_PUBLIC_APP_DOMAIN=https://autoinvestment.broker
NEXT_PUBLIC_APP_NAME=AI Broker
NEXT_PUBLIC_APP_EMAIL=support@autoinvestment.broker

#### Cloudflare D1 (the only database)
# On Workers, D1 is the `DB` binding in wrangler.jsonc — nothing to set here.
# These are only needed OUTSIDE Workers: maintenance scripts, CI, drizzle-kit.
# Token needs D1 edit permission: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
# Defaults to the `ai-broker-db` database id when unset.
CLOUDFLARE_DATABASE_ID=

#### Cloudflare Email Workers (the only mail provider)
# Delivery uses the `SEND_EMAIL` binding in wrangler.jsonc; Email Routing must be
# enabled on the zone and this sender verified on the domain.
EMAIL_FROM=noreply@autoinvestment.broker

#### AUTH & PAY
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=

# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

#### Scheduled Workers triggers (/api/cron/*)
CRON_SECRET=

#### Model providers
# https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

#### Cloudflare Turnstile (first-load bot gate, lib/turnstile)
# Optional. With both keys unset the gate never runs. Set both to challenge a
# desktop browser's first HTML page view once; phones, crawlers, /api/*, assets
# and RSC fetches are never challenged. Create a Managed widget at
# https://dash.cloudflare.com -> Turnstile. See docs/deployment/turnstile-bot-gate.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "false" switches the gate off while keeping the keys in place.
TURNSTILE_ENABLED=
# Seconds one pass lasts. Default 604800 (7 days), clamped to 5 min - 30 days.
TURNSTILE_TTL_SECONDS=
# Share one pass across subdomains, e.g. .autoinvestment.broker
TURNSTILE_COOKIE_DOMAIN=
